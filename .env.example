# ---------------------------------------------------------------
# DebaMun · variables de entorno
# Copia este archivo a apps/api/.env y ajusta los valores.
# ---------------------------------------------------------------

# API NestJS
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL (local o Neon)
# Neon: postgresql://usuario:password@ep-xxx.us-east-2.aws.neon.tech/debamun?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/debamun
DATABASE_SSL=false
DATABASE_POOL_MAX=8

# Redis (opcional).
# Solo para caché compartida entre instancias basta con REDIS_URL.
# BullMQ necesita un worker persistente: actívalo con JOBS_WORKER=1
# (en Vercel/serverless déjalo vacío: la instancia se congela entre peticiones).
# REDIS_URL=redis://127.0.0.1:6379
REDIS_URL=
JOBS_WORKER=

# Servicio Python FastAPI + Scrapy
RESEARCH_SERVICE_URL=http://127.0.0.1:8000
RESEARCH_TIMEOUT_MS=2500
DATA_DIR=

# LLM opcional (cualquier API compatible con OpenAI).
# Sin clave, DebaMun usa recuperación local y rúbrica heurística.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=12000

# Web (crear apps/web/.env.local si la API no está en localhost:4000)
VITE_API_URL=http://localhost:4000/api
